MONSTRA_API_KEY=
MONSTRA_API_BASE_URL=https://www.monstra.bot

# "paper" (default, recommended) or "live"
ALPACA_MODE=paper

ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# true = log the plan only. Set to false only once you're ready to place real trades.
DRY_RUN=true
MIN_TRADE_DOLLARS=25

# Only trade a symbol once it has drifted this many percentage points from
# target (0.03 = 3%), same default as Monstra's own site-side rebalancer.
# Brand-new target positions and full exits to zero always trade regardless.
DRIFT_THRESHOLD=0.03

# How long to wait for sell orders to report "filled" before submitting the
# funded buy orders.
SELL_FILL_TIMEOUT_SECONDS=60

# Each run checks Alpaca's market clock first and exits quietly if the
# market is closed, so it's safe to schedule twice a day without worrying
# about weekends/holidays. Set true to skip that check (e.g. for testing).
SKIP_MARKET_CLOSED_CHECK=false

# Optional overrides.
# ALPACA_LOG_FILE_PATH=C:\path\to\alpaca_rebalance.log
