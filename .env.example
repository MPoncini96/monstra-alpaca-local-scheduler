MONSTRA_API_KEY=
MONSTRA_API_BASE_URL=https://www.monstra.bot

# "paper" (default, recommended) or "live"
ALPACA_MODE=paper

ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# true = log the plan only. Set to false only once you're ready to place real trades.
DRY_RUN=true
MIN_TRADE_DOLLARS=25

# Optional override.
# ALPACA_LOG_FILE_PATH=C:\path\to\alpaca_rebalance.log
